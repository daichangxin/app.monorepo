{
    "name": "app.monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "build:test": "pnpm --stream -r run build:test",
        "build:prod": "pnpm --stream -r run build:prod",
        "app:up": "docker compose -f docker/docker-compose.yml up -d --build",
        "app:down": "docker compose -f docker/docker-compose.yml down",
        "app:restart": "pnpm app:down && pnpm app:up && docker image prune -f",
        "deploy:server": "rimraf server/.deploy && pnpm deploy --filter=server --prod server/.deploy",
        "app:deploy": "pnpm build:prod && pnpm deploy:server && pnpm app:restart",
        "lint": "pnpm -r lint"
    },
    "engines": {
        "node": ">=20",
        "pnpm": ">=10"
    },
    "keywords": [],
    "author": "daichangxin",
    "license": "MIT",
    "devDependencies": {
        "eslint": "^9.34.0",
        "rimraf": "^5.0.10",
        "tailwindcss": "^4.1.12",
        "typescript": "^5.9.2"
    }
}
