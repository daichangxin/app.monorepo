{
    "compilerOptions": {
        "lib": ["DOM", "ES5"],
        "jsx": "react-jsx",
        "target": "es6",
        "module": "esnext",
        "allowJs": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "skipLibCheck": true,
        "strict": true,
        "removeComments": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src"]
}
